{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug"
      },
      "env": {
        "APP_ENV": "development",
        "REVENUECAT_APPLE_API_KEY_TEST": "${REVENUECAT_APPLE_API_KEY_TEST}",
        "REVENUECAT_GOOGLE_API_KEY_TEST": "${REVENUECAT_GOOGLE_API_KEY_TEST}",
        "REVENUECAT_ENTITLEMENT_ID": "${REVENUECAT_ENTITLEMENT_ID}",
        "SENTRY_DSN": "${SENTRY_DSN}"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "APP_ENV": "preview",
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "REVENUECAT_APPLE_API_KEY_TEST": "${REVENUECAT_APPLE_API_KEY_TEST}",
        "REVENUECAT_GOOGLE_API_KEY_TEST": "${REVENUECAT_GOOGLE_API_KEY_TEST}",
        "REVENUECAT_ENTITLEMENT_ID": "${REVENUECAT_ENTITLEMENT_ID}",
        "SENTRY_DSN": "${SENTRY_DSN}"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "REVENUECAT_APPLE_API_KEY_PRODUCTION": "${REVENUECAT_APPLE_API_KEY_PRODUCTION}",
        "REVENUECAT_GOOGLE_API_KEY_PRODUCTION": "${REVENUECAT_GOOGLE_API_KEY_PRODUCTION}",
        "REVENUECAT_ENTITLEMENT_ID": "${REVENUECAT_ENTITLEMENT_ID}",
        "SENTRY_DSN": "${SENTRY_DSN}"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
