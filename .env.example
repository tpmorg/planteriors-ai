# Copy to .env.local for local dev
# For EAS builds, set these as project secrets / env vars.

# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (optional)
APPLE_CLIENT_ID=

# Gemini
GEMINI_API_KEY=

# RevenueCat
REVENUECAT_ENTITLEMENT_ID=Planterior Pro
REVENUECAT_IOS_API_KEY_PRODUCTION=
REVENUECAT_GOOGLE_API_KEY_PRODUCTION=

# App config
APP_NAME=
APP_SCHEME=
APP_DOMAIN=
DEBUG_MODE=
API_TIMEOUT=

# Sentry
SENTRY_DSN=

# Optional
TRUFLE_API_KEY=
