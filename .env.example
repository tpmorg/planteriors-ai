# PlantAI Interior Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# App Configuration
APP_NAME=PlantAI Interior
APP_SCHEME=plant-interior-ai
APP_DOMAIN=plant-interior-ai.app

# Apple Sign-In Configuration (when implemented)
APPLE_CLIENT_ID=your_apple_client_id_here

# Development/Debug flags
DEBUG_MODE=true
API_TIMEOUT=30000
TRUFLE_API_KEY=your_trufle_api_key_here