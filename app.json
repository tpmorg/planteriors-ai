{
  "expo": {
    "jsEngine": "hermes",
    "name": "Planterior AI",
    "slug": "plant-interior-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9fafb"
    },
    "scheme": "plant-interior-ai",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Planterior AI to access your camera to take photos of rooms.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Planterior AI to access your photos to select room images."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Planterior AI to use your microphone for voice plant search.",
          "speechRecognitionPermission": "Allow Planterior AI to convert your speech into plant searches.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Planterior AI to access your photos so you can save designs to your library.",
          "savePhotosPermission": "Allow Planterior AI to save plant design images to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      "expo-apple-authentication",
      "@sentry/react-native/expo",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "FirebaseCore",
                "modular_headers": true
              },
              {
                "name": "FirebaseCoreExtension",
                "modular_headers": true
              },
              {
                "name": "FirebaseCoreInternal",
                "modular_headers": true
              },
              {
                "name": "FirebaseAuthInterop",
                "modular_headers": true
              },
              {
                "name": "FirebaseAppCheckInterop",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.161202796930-np9orfkt885ej10ienccr4rc98n5oar4"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bcs.planterior",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "plant-interior-ai",
            "CFBundleURLSchemes": [
              "plant-interior-ai"
            ]
          },
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.161202796930-np9orfkt885ej10ienccr4rc98n5oar4"
            ]
          },
          {
            "CFBundleURLName": "plant-interior-ai",
            "CFBundleURLSchemes": [
              "plant-interior-ai"
            ]
          },
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.161202796930-np9orfkt885ej10ienccr4rc98n5oar4"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bcs.planterior",
      "icon": "./assets/logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "a325c769-f080-4a11-abf8-23bf1a17ceb8"
      },
      "googleClientId": "${GOOGLE_CLIENT_ID}",
      "geminiApiKey": "${GEMINI_API_KEY}",
      "sentryDsn": "${SENTRY_DSN}"
    },
    "owner": "morgish"
  }
}
