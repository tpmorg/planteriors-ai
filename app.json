{
  "expo": {
    "name": "Planterior AI",
    "slug": "plant-interior-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9fafb"
    },
    "scheme": "plant-interior-ai",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Planterior AI to access your camera to take photos of rooms."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Planterior AI to access your photos to select room images."
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.161202796930-np9orfkt885ej10ienccr4rc98n5oar4"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bcs.planterior",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "plant-interior-ai",
            "CFBundleURLSchemes": [
              "plant-interior-ai"
            ]
          },
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.161202796930-np9orfkt885ej10ienccr4rc98n5oar4"
            ]
          },
          {
            "CFBundleURLName": "plant-interior-ai",
            "CFBundleURLSchemes": [
              "plant-interior-ai"
            ]
          },
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.161202796930-np9orfkt885ej10ienccr4rc98n5oar4"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bcs.planterior",
      "icon": "./assets/logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "a325c769-f080-4a11-abf8-23bf1a17ceb8"
      },
      "googleClientId": "${GOOGLE_CLIENT_ID}",
      "geminiApiKey": "${GEMINI_API_KEY}",
      "revenueCatAppleApiKey": "${REVENUECAT_APPLE_API_KEY}",
      "revenueCatGoogleApiKey": "${REVENUECAT_GOOGLE_API_KEY}"
    },
    "owner": "morgish"
  }
}
