{
  "expo": {
    "name": "PlantAI Interior",
    "slug": "plant-interior-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d5016"
    },
    "scheme": "plant-interior-ai",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PlantAI Interior to access your camera to take photos of rooms."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PlantAI Interior to access your photos to select room images."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plantai.interior",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "plant-interior-ai",
            "CFBundleURLSchemes": ["plant-interior-ai"]
          },
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": ["YOUR_GOOGLE_CLIENT_ID"]
          }
        ]
      }
    },
    "android": {
      "package": "com.plantai.interior",
      "icon": "./assets/h-plant-ai-logo-sm.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/h-plant-ai-logo-sm.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googleClientId": "YOUR_GOOGLE_CLIENT_ID",
      "googleClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
      "geminiApiKey": "AIzaSyAYQjkpWV7KhRwrSTJCsLIEOc6kqVxwUyc",
      "appName": "PlantAI Interior",
      "appScheme": "plant-interior-ai",
      "appDomain": "plant-interior-ai.app",
      "appleClientId": "YOUR_APPLE_CLIENT_ID",
      "debugMode": true,
      "apiTimeout": 30000
    }
  }
}
